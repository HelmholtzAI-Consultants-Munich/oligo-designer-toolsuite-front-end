# Docker-specific overrides
# Copy this file to .env.docker (no changes needed for the default docker-compose setup).
#
# These override the same-named variables from .env, replacing localhost
# addresses with Docker service names for container-to-container networking.

FLASK_MONGO_URI=mongodb://odt-db:27017/oligo_db
CELERY_MONGO_URI=mongodb://odt-db:27017/
CELERY_BROKER=pyamqp://guest@odt-mq/
REDIS_HOST=odt-redis
