# ODT Environment Configuration
# Copy this file to .env and fill in your values.
# See backend/config.py for all available backend options and defaults.
# See src/config.ts for all available frontend options and defaults.

# =============================================================================
# REQUIRED SETTINGS (must be changed in production)
# =============================================================================

# Helmholtz AAI OAuth2 credentials
# Register at: https://login.helmholtz.de/
# WARNING: OAuth2 login is unavailable if left unset
FLASK_HELMHOLTZ_CLIENT_ID=
FLASK_HELMHOLTZ_CLIENT_SECRET=
# Restrict Helmholtz OAuth login to users with one of the required group entitlements.
# Defaults to false when unset, allowing any valid Helmholtz OAuth user.
# FLASK_HELMHOLTZ_RESTRICT_BY_ENTITLEMENT=false
# Required Helmholtz group entitlement prefixes. Values returned with a #issuer suffix still match.
# Add more VOs as comma-separated values.
# Example:
# FLASK_HELMHOLTZ_REQUIRED_ENTITLEMENT=urn:geant:helmholtz.de:group:Helmholtz-member,urn:geant:helmholtz.de:group:SomeOtherVO

# Turnstile keys
# WARNING: These are dummy keys that always pass validation
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Flask secret key
# WARNING: CHANGE IN PRODUCTION!
FLASK_SECRET_KEY=change-me-in-production

# =============================================================================
# NETWORKING SETTINGS (defaults shown, uncomment to override)
# =============================================================================

# MongoDB connection URI
# WARNING: Ignored when using Docker Compose
# MONGO_URI=mongodb://localhost/oligo_db

# Redis connection URI
# WARNING: Ignored when using Docker Compose
# REDIS_URI=redis://localhost

# Frontend URL (React app)
# FRONTEND_URL=http://localhost:3000
# Backend URL (Flask API; for use in backend)
# BACKEND_URL=http://localhost:8000
# Backend URL (Flask API; for use in frontend)
# VITE_BACKEND_URL=http://localhost:8000

# =============================================================================
# OPTIONAL SETTINGS (defaults shown, uncomment to override)
# =============================================================================

# --- Flask configuration (FLASK_ prefix is stripped by Flask's from_prefixed_env) ---

# Directory settings (relative paths)
# FLASK_RELATIVE_DATA_ACCESS_PATH=data-access
# FLASK_RELATIVE_UPLOAD_PATH=uploads
# FLASK_RELATIVE_USERDATA_PATH=user_data

# Maximum request size
# FLASK_MAX_CONTENT_LENGTH = 1073741824

# --- Other settings (not part of Flask config) ---

# Redis cache expiration times
# REDIS_GENERIC_EXPIRATION_TIME=86400
# REDIS_FILE_EXPIRATION_TIME=2592000

# Pipeline timeout configuration
# PIPELINE_TIMEOUT_ANON=3600
# PIPELINE_TIMEOUT_AUTHENTICATED_MULTIPLIER=2.0
# PIPELINE_TIMEOUT_HARD_MARGIN=300

# Playwright settings
PLAYWRIGHT_BACKEND_URL=http://localhost:8000
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_HTML_OUTPUT_DIR= /app/playwright-report

# Maximum feedback message length (for use in backend)
# FEEDBACK_MAX_LENGTH=2000
# Frontend feedback message length (for use in frontend)
# VITE_FEEDBACK_MAX_LENGTH=2000

# Anonymous data retention period in days for automated cleanup tasks
# Default is 30 days (about 1 month)
# ANONYMOUS_DATA_RETENTION_DAYS=30

# Log Level
# LOG_LEVEL=INFO
