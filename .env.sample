# ODT Environment Configuration (LOCAL development)
# Copy this file to .env and fill in your values.
# See backend/config.py for all available backend options and defaults.
#
# This file is used BOTH for local development AND as the base for Docker
# (Docker Compose loads .env first, then .env.docker overrides networking).

# =============================================================================
# REQUIRED SETTINGS (no defaults, must be set for full functionality)
# =============================================================================

# Helmholtz AAI OAuth2 credentials (required for authentication)
# Register at: https://login.helmholtz.de/
FLASK_HELMHOLTZ_CLIENT_ID=
FLASK_HELMHOLTZ_CLIENT_SECRET=

# Turnstile keys (required for verifying turnstile tokens)
# These are dummy keys that always pass validation (CHANGE IN PRODUCTION!)
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# =============================================================================
# OPTIONAL SETTINGS (defaults shown, uncomment to override)
# =============================================================================

# --- Flask configuration (FLASK_ prefix is stripped by Flask's from_prefixed_env) ---

# Flask secret key for session encryption (CHANGE IN PRODUCTION!)
# FLASK_SECRET_KEY=change-me-in-production

# Directory settings (relative paths)
# FLASK_RELATIVE_DATA_ACCESS_PATH=data-access
# FLASK_RELATIVE_UPLOAD_PATH=uploads
# FLASK_RELATIVE_USERDATA_PATH=user_data

# --- Other settings (not part of Flask config) ---

# MongoDB connection URI
# MONGO_URI=mongodb://localhost/oligo_db

# Redis connection URI
# REDIS_URI=redis://localhost
# REDIS_GENERIC_EXPIRATION_TIME=86400
# REDIS_FILE_EXPIRATION_TIME=2592000

# Pipeline timeout configuration
# PIPELINE_TIMEOUT_ANON=3600
# PIPELINE_TIMEOUT_AUTHENTICATED_MULTIPLIER=2.0
# PIPELINE_TIMEOUT_HARD_MARGIN=300

# Frontend URL (where the React app is running)
# FRONTEND_URL=http://localhost:3000
# Backend URL (where the Flask API runs; used by backend/OAuth)
# BACKEND_URL=http://localhost:5000
# Frontend backend URL (used by Vite/React)
# VITE_BACKEND_URL=http://

# Playwright settings
PLAYWRIGHT_BACKEND_URL=http://localhost:5000
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_HTML_OUTPUT_DIR= /app/playwright-report

# Maximum feedback message length (used by backend)
# FEEDBACK_MAX_LENGTH=2000

# Anonymous data retention period in days for automated cleanup tasks
# Default is 30 days (about 1 month)
# ANONYMOUS_DATA_RETENTION_DAYS=30
# Frontend feedback message length (used by Vite/React)
# VITE_FEEDBACK_MAX_LENGTH=2000

# Maximum request size
# MAX_CONTENT_LENGTH = 1073741824

# Log Level
# LOG_LEVEL=INFO
