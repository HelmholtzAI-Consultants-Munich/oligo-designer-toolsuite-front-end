# Ignore everything except the flask directory
# see https://docs.docker.com/build/cache/optimize/#keep-the-context-small
/*
!/flask

# Python artifacts
**/__pycache__
**/.pytest_cache

# Data
/flask/data
/flask/user_data/*

# Exceptions for test user data (TODO: remove once tests are independent)
!/flask/user_data/

!/flask/user_data/testuser123/

!/flask/user_data/anon/
/flask/user_data/anon/*

!/flask/user_data/anon/anon-session-123/
