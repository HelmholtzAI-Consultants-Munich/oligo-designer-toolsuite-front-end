# Ignore everything except the backend directory
# see https://docs.docker.com/build/cache/optimize/#keep-the-context-small
/*
!/backend

# Python artifacts
**/__pycache__
**/.pytest_cache

# Data
/backend/data
/backend/data-access/*

# Exceptions for test user data (TODO: remove once tests are independent)
!/backend/data-access/user_data/
/backend/data-access/user_data/*

!/backend/data-access/user_data/testuser123/

!/backend/data-access/user_data/anon/
/backend/data-access/user_data/anon/*

!/backend/data-access/user_data/anon/anon-session-123/
