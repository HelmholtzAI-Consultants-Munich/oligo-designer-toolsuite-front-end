# Ignore everything except the schemas and flask directory
# see https://docs.docker.com/build/cache/optimize/#keep-the-context-small
/*
!/schemas
!/flask

# Ignore directory contents in the flask directory except for the worker directory
/flask/*/*
!/flask/worker/*
!/flask/routes/genomic_database_helpers.py

# Python artifacts
**/__pycache__
**/.pytest_cache
