# Ignore everything except the schemas and backend directory
# see https://docs.docker.com/build/cache/optimize/#keep-the-context-small
/*
!/schemas
!/backend

# Ignore directory contents in the backend directory except for specific files and directories
/backend/*
!/backend/__init__.py
!/backend/cache.py
!/backend/config.py
!/backend/extensions.py
!/backend/genomic_databases.py
!/backend/pyproject.toml
!/backend/worker_environment.yml
!/backend/worker
!/backend/data-access
/backend/data-access/*
!/backend/cache
/backend/cache/*

# Python artifacts
**/__pycache__
**/.pytest_cache
