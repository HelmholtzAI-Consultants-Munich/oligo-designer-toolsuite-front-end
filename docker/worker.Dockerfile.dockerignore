# Ignore everything except the backend directory
# see https://docs.docker.com/build/cache/optimize/#keep-the-context-small
/*
!/backend

# Ignore directory contents in the backend directory except for specific files and directories
/backend/*
!/backend/__init__.py
!/backend/cache.py
!/backend/constants.py
!/backend/config.py
!/backend/database.py
!/backend/extensions.py
!/backend/queue_accounting.py
!/backend/genomic_databases.py
!/backend/types.py
!/backend/models.py
!/backend/utils.py
!/backend/exceptions.py
!/backend/pyproject.toml
!/backend/environment.yml
!/backend/worker.environment.yml
!/backend/worker
!/backend/data-access
/backend/data-access/*
!/backend/cache
/backend/cache/*

# Python artifacts
**/__pycache__
**/.pytest_cache
