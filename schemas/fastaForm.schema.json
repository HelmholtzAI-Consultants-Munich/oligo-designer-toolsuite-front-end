{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odt:fastaForm",
  "type": "object",
  "definitions": {
    "FastaFormUpload": {
      "type": "object",
      "required": ["source", "formData"],
      "properties": {
        "source": {
          "type": "string",
          "default": ""
        },
        "formData": {
          "anyOf": [
            { "$ref": "#/definitions/NcbiFastaFormDataUncommented" },
            { "$ref": "#/definitions/EnsFastaFormDataUncommented" }
          ]
        }
      }
    },
    "genomic_input": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "object" },
          "default": [],
          "title": "Files Fasta Target Probe Database",
          "description": "fasta file with sequences form which the probes should be generated. Hint: use the genomic_region_generator pipeline to create fasta files of genomic regions of interest"
        },
        "fasta_form": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/FastaFormUncommented"
          },
          "default": []
        }
      }
    },
    "EnsSourceParamsUncommented": {
      "type": "object",
      "required": ["species", "annotation_release"],
      "additionalProperties": false,
      "properties": {
        "species": {
          "type": "string",
          "description": "required: species name in ensemble download format, e.g. 'homo_sapiens' for human; see http://ftp.ensembl.org/pub/release-108/gtf/ for available species names",
          "default": "homo_sapiens"
        },
        "annotation_release": {
          "type": "string",
          "description": "required: release number of annotation, e.g. 'release-108' or 'current' to use most recent annotation release. Check out release numbers for ensemble at ftp.ensembl.org/pub/",
          "default": "current"
        }
      }
    },
    "NcbiSourceParamsUncommented": {
      "type": "object",
      "required": ["species", "annotation_release", "taxon"],
      "additionalProperties": false,
      "properties": {
        "species": {
          "type": "string",
          "default": "Homo_sapiens",
          "description": "required: species name in NCBI download format, e.g. 'Homo_sapiens' for human; see https://ftp.ncbi.nlm.nih.gov/genomes/refseq/ for available species name"
        },
        "annotation_release": {
          "type": "string",
          "default": "110",
          "description": "required: release number of annotation e.g. '109' or '109.20211119'  or 'current' to use most recent annotation release. Check out release numbers for NCBI at ftp.ncbi.nlm.nih.gov/refseq/H_sapiens/annotation/annotation_releases/"
        },
        "taxon": {
          "type": "string",
          "default": "vertebrate_mammalian",
          "description": "required: taxon of the species, valid taxa are: archaea, bacteria, fungi, invertebrate, mitochondrion, plant, plasmid, plastid, protozoa, vertebrate_mammalian, vertebrate_other, viral"
        }
      }
    },
    "GenomicRegionsUncommented": {
      "type": "object",
      "required": [
        "gene",
        "intergenic",
        "exon",
        "exon_exon_junction",
        "utr",
        "cds",
        "intron"
      ],
      "additionalProperties": false,
      "properties": {
        "gene": {
          "type": "string",
          "default": "false"
        },
        "intergenic": {
          "type": "string",
          "default": "false"
        },
        "exon": {
          "type": "string",
          "default": "true"
        },
        "exon_exon_junction": {
          "type": "string",
          "default": "false"
        },
        "utr": {
          "type": "string",
          "default": "false"
        },
        "cds": {
          "type": "string",
          "default": "false"
        },
        "intron": {
          "type": "string",
          "default": "false"
        }
      }
    },
    "FastaFormUncommented": {
      "type": "object",
      "required": ["selectedSource", "formDataNcbi", "formDataEns"],
      "additionalProperties": false,
      "properties": {
        "selectedSource": {
          "type": "string",
          "default": "ncbi"
        },
        "formDataNcbi": {
          "$ref": "#/definitions/NcbiFastaFormDataUncommented"
        },
        "formDataEns": {
          "$ref": "#/definitions/EnsFastaFormDataUncommented"
        }
      }
    },
    "NcbiFastaFormDataUncommented": {
      "type": "object",
      "required": [
        "source",
        "source_params",
        "genomic_regions",
        "exon_exon_junction_block_size"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "default": "ncbi",
          "description": "required: indicate that ncbi annotation should be used"
        },
        "source_params": {
          "$ref": "#/definitions/NcbiSourceParamsUncommented"
        },
        "genomic_regions": {
          "$ref": "#/definitions/GenomicRegionsUncommented"
        },
        "exon_exon_junction_block_size": {
          "type": "string",
          "default": "50"
        }
      }
    },
    "EnsFastaFormDataUncommented": {
      "type": "object",
      "required": [
        "source",
        "source_params",
        "genomic_regions",
        "exon_exon_junction_block_size"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "default": "ensembl"
        },
        "source_params": {
          "$ref": "#/definitions/EnsSourceParamsUncommented"
        },
        "genomic_regions": {
          "$ref": "#/definitions/GenomicRegionsUncommented"
        },
        "exon_exon_junction_block_size": {
          "type": "string",
          "default": "50"
        }
      }
    }
  }
}
