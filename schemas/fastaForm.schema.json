{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odt:fastaForm",
  "type": "object",
  "required": [
    "files_fasta_target_probe_database",
    "files_fasta_reference_database_target_probe",
    "files_fasta_reference_database_readout_probe",
    "files_fasta_reference_database_primer"
  ],
  "additionalProperties": false,
  "properties": {
    "files_fasta_target_probe_database": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FastaFormUncommented"
      },
      "default": []
    },
    "files_fasta_reference_database_target_probe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FastaFormUncommented"
      },
      "default": []
    },
    "files_fasta_reference_database_readout_probe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FastaFormUncommented"
      },
      "default": []
    },
    "files_fasta_reference_database_primer": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FastaFormUncommented"
      },
      "default": []
    }
  },
  "$defs": {
    "EnsSourceParamsUncommented": {
      "type": "object",
      "required": ["species", "annotation_release"],
      "additionalProperties": false,
      "properties": {
        "species": {
          "type": "string"
        },
        "annotation_release": {
          "type": "string"
        }
      }
    },
    "NcbiSourceParamsUncommented": {
      "type": "object",
      "required": ["species", "annotation_release", "taxon"],
      "additionalProperties": false,
      "properties": {
        "species": {
          "type": "string"
        },
        "annotation_release": {
          "type": "string"
        },
        "taxon": {
          "type": "string"
        }
      }
    },
    "GenomicRegionsUncommented": {
      "type": "object",
      "required": [
        "gene",
        "intergenic",
        "exon",
        "exon_exon_junction",
        "utr",
        "cds",
        "intron"
      ],
      "additionalProperties": false,
      "properties": {
        "gene": {
          "type": "string"
        },
        "intergenic": {
          "type": "string"
        },
        "exon": {
          "type": "string"
        },
        "exon_exon_junction": {
          "type": "string"
        },
        "utr": {
          "type": "string"
        },
        "cds": {
          "type": "string"
        },
        "intron": {
          "type": "string"
        }
      }
    },
    "NcbiFastaFormDataUncommented": {
      "type": "object",
      "required": [
        "dir_output",
        "source",
        "source_params",
        "genomic_regions",
        "exon_exon_junction_block_size"
      ],
      "additionalProperties": false,
      "properties": {
        "dir_output": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_params": {
          "$ref": "#/$defs/NcbiSourceParamsUncommented"
        },
        "genomic_regions": {
          "$ref": "#/$defs/GenomicRegionsUncommented"
        },
        "exon_exon_junction_block_size": {
          "type": "string"
        }
      }
    },
    "EnsFastaFormDataUncommented": {
      "type": "object",
      "required": [
        "dir_output",
        "source",
        "source_params",
        "genomic_regions",
        "exon_exon_junction_block_size"
      ],
      "additionalProperties": false,
      "properties": {
        "dir_output": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_params": {
          "$ref": "#/$defs/EnsSourceParamsUncommented"
        },
        "genomic_regions": {
          "$ref": "#/$defs/GenomicRegionsUncommented"
        },
        "exon_exon_junction_block_size": {
          "type": "string"
        }
      }
    },
    "FastaFormUncommented": {
      "type": "object",
      "required": ["selectedSource", "formDataNcbi", "formDataEns"],
      "additionalProperties": false,
      "properties": {
        "selectedSource": {
          "type": "string"
        },
        "formDataNcbi": {
          "$ref": "#/$defs/NcbiFastaFormDataUncommented"
        },
        "formDataEns": {
          "$ref": "#/$defs/EnsFastaFormDataUncommented"
        }
      }
    },
    "FastaFormUpload": {
      "type": "object",
      "required": ["source", "formData"],
      "anyOf": [
        { "$ref": "#/$defs/NcbiFastaFormDataUncommented" },
        { "$ref": "#/$defs/EnsFastaFormDataUncommented" }
      ],
      "properties": {
        "source": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
