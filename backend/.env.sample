# Flask Backend Environment Configuration
# Copy this file to .env and fill in your values
# See backend/config.py for all available options and defaults

# =============================================================================
# REQUIRED SETTINGS (no defaults, must be set for full functionality)
# =============================================================================

# Helmholtz AAI OAuth2 credentials (required for authentication)
# Register at: https://login.helmholtz.de/
HELMHOLTZ_CLIENT_ID=
HELMHOLTZ_CLIENT_SECRET=

# =============================================================================
# OPTIONAL SETTINGS (defaults shown, uncomment to override)
# =============================================================================

# Flask secret key for session encryption (CHANGE IN PRODUCTION!)
# SECRET_KEY=change-me-in-production

# MongoDB connection URI
# MONGO_URI=mongodb://localhost:27017/oligo_db

# Directory settings (relative paths)
# RELATIVE_DATA_ACCESS_PATH=data-access
# RELATIVE_UPLOAD_PATH=uploads
# RELATIVE_USERDATA_PATH=user_data

# Celery message broker (RabbitMQ)
# CELERY_BROKER=pyamqp://guest@localhost//

# Celery result backend (MongoDB)
# CELERY_MONGO_URI=mongodb://localhost:27017/
